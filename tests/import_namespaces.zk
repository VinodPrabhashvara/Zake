import std.string as string
import std.math as math
from std.encoding import base64_encode, base64_decode
import "../examples/math_utils.zk" as utils

print(string.upper("zake"))
print(string.lower("ZAKE"))
print(math.square(4))
print(math.cube(2))

let encoded = base64_encode("test")
print(encoded)
print(base64_decode(encoded))

print(utils.add(7, 8))
