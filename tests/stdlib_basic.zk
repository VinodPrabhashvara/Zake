import std.string
import std.math
import std.encoding
import std.time
import std.path

print(starts_with("zake language", "zake"))
print(ends_with("zake language", "lang"))
print(trim("  clean  "))
print(length("Zake"))

print(square(4))
print(cube(2))
print(sqrt(25))

let encoded = hex_encode("text")
print(hex_decode(encoded))
print(abs(-5))

let hexed = hex_encode("hi")
print(hexed)
print(hex_decode(hexed))

let b64 = base64_encode("code")
print(b64)
print(base64_decode(b64))

print(type(now()))
print(type(timestamp()))

print(join("a", "b"))
print(basename("a/b.txt"))
print(dirname("a/b.txt"))
print(extension("a/b.txt"))
